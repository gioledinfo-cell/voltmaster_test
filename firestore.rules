rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to read and write app resources
    match /cantieri/{cantiereId} {
      allow read, write: if request.auth != null || true;
    }

    match /rols/{rolId} {
      allow read, write: if request.auth != null || true;
    }

    match /veicoli/{veicoloId} {
      allow read, write: if request.auth != null || true;
    }

    match /attrezzature/{attrezzaturaId} {
      allow read, write: if request.auth != null || true;
    }

    match /presenze/{presenzaId} {
      allow read, write: if request.auth != null || true;
    }

    match /sals/{salId} {
      allow read, write: if request.auth != null || true;
    }

    match /ddts/{ddtId} {
      allow read, write: if request.auth != null || true;
    }

    match /ordini/{ordineId} {
      allow read, write: if request.auth != null || true;
    }

    match /scadenze/{scadenzaId} {
      allow read, write: if request.auth != null || true;
    }

    match /dipendenti/{dipendenteId} {
      allow read, write: if request.auth != null || true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
